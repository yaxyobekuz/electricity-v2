// Electricity — elektr tarmog'i hisobi va tahlili.
//
// Ierarxiya (.claude/docs/ dagi hujjat va Excel hisobotlar asosida):
//   ETK → Podstansiya → Ввод (Т1/Т2) → Fider (10 kV) → TP → Abonent
//
// Ввод — podstansiya ICHIDAGI katta kuch transformatori.
// TP    — mahallalardagi, KO'CHADAGI transformator punkti.
//
// Ikki darajada oylik o'lchov olinadi:
//   FeederReading — fider darajasi  ("umumiy hisobot" varaqasi)
//   TpReading     — TP darajasi     ("to'liq hisobot" varaqasi)
// Ikkalasida ham: iste'mol = (joriy − oldingi) × koeffitsient

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Elektr tarmoqlari korxonasi — "Chinobod ETK".
model Etk {
  id   String @id @default(uuid())
  name String @unique
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  substations Substation[]

  @@map("etks")
}

/// Podstansiya — 110 kV kirib, 35 kV va 10 kV ga bo'linib beriladi.
model Substation {
  id    String @id @default(uuid())
  etkId String

  /// "НИМ станция Чинобод 110/35/10 кВ"
  name        String @unique
  /// "110/35/10"
  voltageType String
  address     String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etk          Etk           @relation(fields: [etkId], references: [id], onDelete: Cascade)
  transformers Transformer[]

  @@index([etkId])
  @@map("substations")
}

/// Ввод — podstansiya ichidagi kuch transformatori (Т1, Т2).
model Transformer {
  id           String @id @default(uuid())
  substationId String

  /// "ВВОД Т1 25 000 кВА"
  name        String
  /// Quvvati, kVA: 25000 / 40000
  capacityKva Int
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  substation Substation @relation(fields: [substationId], references: [id], onDelete: Cascade)
  feeders    Feeder[]

  @@unique([substationId, name])
  @@index([substationId])
  @@map("transformers")
}

/// 10 kV fider — ввод'dan ajralib chiquvchi liniya.
model Feeder {
  id            String @id @default(uuid())
  transformerId String

  /// Asosiy nom. Hujjatlarda kirillcha keladi: "Жўжахона".
  name    String
  /// Kuchlanish, kV.
  voltage Int    @default(10)

  /// Tok transformatori (TT) koeffitsienti: 1000, 2000, 3000, 4000, 6000.
  /// Hisoblagich farqi shu songa ko'paytiriladi.
  coefficient Int

  /// Boshqa alifbo/imlodagi variantlar: "Jo'jaxona", "Jojaxona".
  /// Excel import fider nomini shu ro'yxat bo'yicha ham qidiradi —
  /// hujjatlarning bir qismi lotin, bir qismi kirill yozuvida kelgani uchun.
  aliases String[] @default([])

  isActive Boolean @default(true)
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transformer Transformer     @relation(fields: [transformerId], references: [id], onDelete: Cascade)
  readings    FeederReading[]
  tpPoints    TpPoint[]

  @@unique([transformerId, name])
  @@index([transformerId])
  @@map("feeders")
}

/// Fiderning oylik ko'rsatkichi — "umumiy hisobot" varaqasidagi qator.
model FeederReading {
  id       String @id @default(uuid())
  feederId String

  /// Hisobot davri — oyning 1-kuni (masalan 2026-08-01).
  period DateTime @db.Date

  meterValue    Decimal @db.Decimal(14, 2)
  previousValue Decimal @default(0) @db.Decimal(14, 2)
  /// meterValue − previousValue ("Фарки" ustuni).
  difference    Decimal @db.Decimal(14, 2)
  /// difference × coefficient ("Бир ойлик окиб утган электр").
  consumedKwh   Decimal @db.Decimal(16, 2)
  /// Hisob paytidagi koeffitsient nusxasi.
  coefficient   Int

  /// "Elektr oqimi" — TP hisoblagichlari bo'yicha real o'tgan miqdor.
  /// Hamma fiderda o'lchanmagan, shuning uchun ixtiyoriy.
  electricFlowKwh Decimal? @db.Decimal(16, 2)

  /// Texnologik yo'qotish foizi (hujjatda 12%).
  technicalLossPercent Decimal  @default(12) @db.Decimal(5, 2)
  /// consumedKwh × technicalLossPercent / 100
  technicalLossKwh     Decimal? @db.Decimal(16, 2)
  /// consumedKwh − electricFlowKwh − technicalLossKwh
  commercialLossKwh    Decimal? @db.Decimal(16, 2)

  /// Fiderning ENG BIRINCHI o'lchovi — oldingi qiymat yo'q, iste'mol
  /// hisoblanmaydi. Aks holda hisoblagichning umrlik ko'rsatkichi bir oylik
  /// iste'mol deb olinib, natija yuz barobar shishib ketadi.
  isBaseline Boolean @default(false)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeder Feeder @relation(fields: [feederId], references: [id], onDelete: Cascade)

  @@unique([feederId, period])
  @@index([period])
  @@map("feeder_readings")
}

/// TP — mahalladagi transformator punkti va uning balans hisoblagichi.
model TpPoint {
  id       String @id @default(uuid())
  feederId String

  /// "1", "29A", "44А" — harf ham uchraydi, shuning uchun matn.
  tpNumber String @unique
  address  String?

  /// Balans hisoblagichi turi: "EX518 5A".
  meterType   String?
  /// Hisoblagich raqami: "124200518951".
  meterSerial String? @unique
  /// TP hisoblagichi koeffitsienti: 20, 40, 60, 70, 80, 120.
  coefficient Int

  capacityKva Int?
  isActive    Boolean @default(true)
  note        String?

  /// Abonentlarning JORIY soni — TP kartochkasida ko'rsatiladi va qo'lda
  /// tahrirlanadi. Oylik tarix `TpReading` da alohida saqlanadi; import
  /// oxirgi hisobotdan shu joriy qiymatlarni ham yangilab qo'yadi.
  consumersTotal   Int?
  consumersOnline  Int?
  consumersOffline Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeder   Feeder      @relation(fields: [feederId], references: [id], onDelete: Cascade)
  readings TpReading[]

  @@index([feederId])
  @@map("tp_points")
}

/// TP ning oylik ko'rsatkichi — "to'liq hisobot" varaqasidagi qator.
model TpReading {
  id        String @id @default(uuid())
  tpPointId String

  period DateTime @db.Date

  meterValue    Decimal @db.Decimal(14, 2)
  previousValue Decimal @default(0) @db.Decimal(14, 2)
  /// meterValue − previousValue ("Farqi").
  difference    Decimal @db.Decimal(14, 2)
  /// difference × coefficient ("Bir oylik iste'moli").
  consumedKwh   Decimal @db.Decimal(16, 2)
  coefficient   Int

  /// Abonentlar soni — har oyda o'zgaradi, shuning uchun o'lchovga bog'langan.
  consumersTotal   Int?
  /// "Aloqaga chiqayotgan" — hisoblagichi aloqada bo'lgan abonentlar.
  consumersOnline  Int?
  /// "Aloqadan chiqib ketgan".
  consumersOffline Int?

  /// Tarif zonalari bo'yicha taqsimot (T1–T4).
  zoneT1 Decimal? @db.Decimal(14, 2)
  zoneT2 Decimal? @db.Decimal(14, 2)
  zoneT3 Decimal? @db.Decimal(14, 2)
  zoneT4 Decimal? @db.Decimal(14, 2)

  /// Reaktiv energiya: R+ va R− (kWh).
  reactivePlus  Decimal? @db.Decimal(14, 2)
  reactiveMinus Decimal? @db.Decimal(14, 2)

  isBaseline Boolean @default(false)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tpPoint TpPoint @relation(fields: [tpPointId], references: [id], onDelete: Cascade)

  @@unique([tpPointId, period])
  @@index([period])
  @@map("tp_readings")
}
