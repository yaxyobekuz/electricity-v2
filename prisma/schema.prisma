// Electricity — elektr energiyasi iste'moli hisobi va boshqaruvi.
// Hujjat: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enum'lar ───────────────────────────

/// Iste'molchi turi — jismoniy yoki yuridik shaxs.
enum ConsumerType {
  INDIVIDUAL // jismoniy shaxs
  LEGAL // yuridik shaxs
}

enum MeterType {
  SINGLE_PHASE // bir fazali
  THREE_PHASE // uch fazali
}

enum MeterStatus {
  ACTIVE // ishlayapti
  INACTIVE // vaqtincha o'chirilgan
  FAULTY // nosoz
  REMOVED // demontaj qilingan
}

/// Ko'rsatkich qanday olingani.
enum ReadingSource {
  MANUAL // nazoratchi qo'lda kiritgan
  AUTO // avtomatik (smart hisoblagich)
  ESTIMATED // o'rtacha bo'yicha hisoblangan
}

/// Tarif toifasi — narx shu toifaga bog'liq.
enum TariffCategory {
  RESIDENTIAL // aholi
  COMMERCIAL // tijorat
  INDUSTRIAL // sanoat
  AGRICULTURAL // qishloq xo'jaligi
}

enum InvoiceStatus {
  DRAFT // shakllantirilmoqda
  ISSUED // chiqarilgan
  PARTIALLY_PAID // qisman to'langan
  PAID // to'liq to'langan
  OVERDUE // muddati o'tgan
  CANCELLED // bekor qilingan
}

enum PaymentMethod {
  CASH // naqd
  CARD // plastik karta
  TRANSFER // bank o'tkazmasi
  ONLINE // onlayn to'lov tizimi
}

enum UserRole {
  ADMIN // to'liq huquq
  OPERATOR // hisob-faktura, to'lov
  INSPECTOR // faqat ko'rsatkich kiritish
}

// ─────────────────────────── Modellar ───────────────────────────

/// Tizim foydalanuvchisi (xodim). Iste'molchi emas.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  readings Reading[] @relation("ReadingRecordedBy")

  @@map("users")
}

/// Elektr energiyasi iste'molchisi (abonent).
model Consumer {
  id       String       @id @default(uuid())
  /// Shartnoma / abonent raqami — hujjatlarda ishlatiladigan asosiy identifikator.
  code     String       @unique
  fullName String
  type     ConsumerType @default(INDIVIDUAL)
  phone    String?
  email    String?

  region   String?
  district String?
  address  String

  /// Joriy balans. Musbat — oldindan to'langan, manfiy — qarz.
  balance  Decimal @default(0) @db.Decimal(14, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meters   Meter[]
  invoices Invoice[]
  payments Payment[]

  @@index([region, district])
  @@index([isActive])
  @@map("consumers")
}

/// Iste'molchiga o'rnatilgan hisoblagich.
model Meter {
  id           String      @id @default(uuid())
  serialNumber String      @unique
  consumerId   String
  type         MeterType   @default(SINGLE_PHASE)
  status       MeterStatus @default(ACTIVE)
  model        String?

  /// O'rnatilgan paytdagi boshlang'ich ko'rsatkich (kVt·s).
  initialReading Decimal   @default(0) @db.Decimal(12, 2)
  installedAt    DateTime  @default(now())
  /// Oxirgi texnik tekshiruv sanasi.
  lastCheckedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumer Consumer  @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  readings Reading[]

  @@index([consumerId])
  @@index([status])
  @@map("meters")
}

/// Hisoblagichdan olingan oylik ko'rsatkich.
model Reading {
  id      String @id @default(uuid())
  meterId String

  /// Hisobot davri, oyning birinchi kuni sifatida saqlanadi (masalan 2026-08-01).
  period DateTime @db.Date

  /// Hisoblagichning shu davrdagi umumiy ko'rsatkichi (kVt·s).
  value         Decimal @db.Decimal(12, 2)
  /// Oldingi davr ko'rsatkichi — hisobni tekshirish uchun saqlanadi.
  previousValue Decimal @default(0) @db.Decimal(12, 2)
  /// value - previousValue. Denormalizatsiya: hisobotlarni tezlashtiradi.
  consumption   Decimal @db.Decimal(12, 2)

  source      ReadingSource @default(MANUAL)
  readingDate DateTime      @default(now())
  note        String?

  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meter      Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("ReadingRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  invoice    Invoice?

  /// Bitta hisoblagich uchun bir davrda faqat bitta ko'rsatkich.
  @@unique([meterId, period])
  @@index([period])
  @@map("readings")
}

/// Narx toifasi. Narx o'zgarganda eski yozuv tahrirlanmaydi —
/// validTo qo'yilib, yangi yozuv ochiladi (tarix saqlanishi uchun).
model Tariff {
  id          String         @id @default(uuid())
  name        String
  category    TariffCategory @default(RESIDENTIAL)
  /// 1 kVt·s narxi.
  pricePerKwh Decimal        @db.Decimal(12, 4)
  currency    String         @default("UZS")

  validFrom DateTime  @default(now())
  validTo   DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([category, isActive])
  @@map("tariffs")
}

/// Oylik hisob-faktura: ko'rsatkich + tarif → to'lanishi kerak bo'lgan summa.
model Invoice {
  id         String @id @default(uuid())
  /// Ko'rinadigan hisob raqami, masalan "INV-2026-08-000123".
  number     String @unique
  consumerId String
  /// Har bir ko'rsatkichdan ko'pi bilan bitta hisob-faktura chiqadi.
  readingId  String @unique
  tariffId   String

  period DateTime @db.Date

  /// Hisob-faktura chiqarilgan paytdagi qiymatlar — keyin tarif o'zgarsa ham
  /// bu yozuv o'zgarmaydi (tarixiy aniqlik uchun nusxa saqlanadi).
  consumptionKwh Decimal @db.Decimal(12, 2)
  pricePerKwh    Decimal @db.Decimal(12, 4)
  amount         Decimal @db.Decimal(14, 2)
  /// Shu hisob-fakturaga tushgan to'lovlar yig'indisi.
  paidAmount     Decimal @default(0) @db.Decimal(14, 2)

  status   InvoiceStatus @default(DRAFT)
  issuedAt DateTime?
  dueDate  DateTime?
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumer Consumer  @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  reading  Reading   @relation(fields: [readingId], references: [id], onDelete: Cascade)
  tariff   Tariff    @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([consumerId, period])
  @@index([status])
  @@map("invoices")
}

/// Iste'molchidan tushgan to'lov. Hisob-fakturaga bog'lanmasligi ham mumkin
/// (oldindan to'lov / balansni to'ldirish).
model Payment {
  id         String  @id @default(uuid())
  consumerId String
  invoiceId  String?

  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod @default(CASH)
  /// Tashqi tizim tranzaksiya raqami / kvitansiya.
  reference String?
  paidAt    DateTime      @default(now())
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([consumerId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}
